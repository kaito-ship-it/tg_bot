# Secrets and machine-specific configuration
.env
.env.*
!.env.example
!.env.production.example

# Local credential artifacts must never be committed
*.session
*.session-*
*.session-journal

# Runtime data can contain downloaded articles, photos and chat identifiers
data/*
!data/.gitkeep

# Local Python environments and caches
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.py[cod]
.coverage
htmlcov/

# Logs and generated diagnostics
*.log

# Editor/OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
