# Telegram user API credentials from https://my.telegram.org
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=tg2site
TELEGRAM_CHANNEL=@your_channel
TG_CHANNEL_ID=-1001234567890
TG_ADMIN_USER_IDS=123456789
# Use telethon locally. Switch to webhook only after nginx and setWebhook are ready.
TELEGRAM_INGEST_MODE=telethon
TG_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_ENFORCE_IPS=false

# Bot that sends the prepared link to the author
BOT_TOKEN=
NOTIFY_CHAT_ID=

# Nedra admin page
ADMIN_BASE_URL=https://dev.nedra.kz/admin/news

# disabled, backend_api, local_browser (Windows + Tampermonkey), or playwright
PUBLISH_MODE=disabled
# Legacy local switch. Prefer PUBLISH_MODE for new installations.
AUTO_OPEN_ADMIN=false
AUTO_PUBLISH_TIMEOUT_SECONDS=90
# Leave empty to use the Windows default browser. Optional example: chrome
BROWSER_COMMAND=

# VPS Playwright settings. Capture the auth file before starting the service.
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO_MS=0
PLAYWRIGHT_AUTH_STATE=data/admin_auth.json

# Direct Laravel publication API (recommended production mode)
NEWS_BOT_API_BASE=https://dev.nedra.kz/api/internal
NEWS_BOT_API_TOKEN=

# Local server now. On VPS, bind to 0.0.0.0 and use the public HTTPS URL below.
API_HOST=127.0.0.1
API_PORT=8000
PUBLIC_API_BASE=http://localhost:8000

# Draft lifetime and album collection window
DRAFT_TTL_HOURS=24
ALBUM_WAIT_SECONDS=2

# Use a Telegram/article photo first. OpenAI runs only when no photo was found.
IMAGE_FALLBACK_MODE=disabled
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1536x1024

# Use OpenAI only when keyword rules cannot choose one category confidently.
CATEGORY_CLASSIFIER_MODE=disabled
OPENAI_TEXT_MODEL=gpt-5.4-nano

# Comma-separated browser origins allowed to read drafts/photos.
CORS_ORIGINS=https://dev.nedra.kz
