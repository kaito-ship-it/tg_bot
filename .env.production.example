# Telegram service bot, source channel and private moderation chat
TG_CHANNEL_ID=
TG_ADMIN_USER_IDS=
BOT_TOKEN=
NOTIFY_CHAT_ID=
TG_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_ENFORCE_IPS=true

# Nedra backend API
NEWS_BOT_API_BASE=https://dev.nedra.kz/api/internal
NEWS_BOT_API_TOKEN=
ADMIN_BASE_URL=https://dev.nedra.kz/admin/news

# FastAPI is reachable only through the HTTPS nginx /tg routes
API_HOST=127.0.0.1
API_PORT=8081
PUBLIC_API_BASE=https://dev.nedra.kz/tg
MEDIA_SIGNING_SECRET=
WEBHOOK_MAX_BODY_BYTES=1000000

# Persistent VPS data
DATA_DIR=/var/lib/tg2site
DRAFT_TTL_HOURS=48
RETENTION_DAYS=30

# Optional AI image fallback and category classifier
IMAGE_FALLBACK_MODE=disabled
CATEGORY_CLASSIFIER_MODE=disabled
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_TEXT_MODEL=gpt-5.4-nano

ALLOW_INSECURE_HTTP=false
