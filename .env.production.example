# Production uses a service bot webhook. Personal Telegram API credentials and
# *.session files are not required.
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=tg2site
TELEGRAM_CHANNEL=@your_channel
TG_CHANNEL_ID=
TG_ADMIN_USER_IDS=
TELEGRAM_INGEST_MODE=webhook
TG_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_ENFORCE_IPS=true

# Organization-owned bot and moderation chat
BOT_TOKEN=
NOTIFY_CHAT_ID=

# Nedra endpoints
ADMIN_BASE_URL=https://dev.nedra.kz/admin/news
PUBLISH_MODE=backend_api
NEWS_BOT_API_BASE=https://dev.nedra.kz/api/internal
NEWS_BOT_API_TOKEN=

# Local listener behind the HTTPS nginx /tg reverse proxy
API_HOST=127.0.0.1
API_PORT=8081
PUBLIC_API_BASE=https://dev.nedra.kz/tg
CORS_ORIGINS=https://dev.nedra.kz

# Runtime storage and queue settings
DATA_DIR=/var/lib/tg2site
DRAFT_TTL_HOURS=24
ALBUM_WAIT_SECONDS=2

# Optional AI fallback. Set to openai only after adding a new server-side key.
IMAGE_FALLBACK_MODE=disabled
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1536x1024
CATEGORY_CLASSIFIER_MODE=disabled
OPENAI_TEXT_MODEL=gpt-5.4-nano

# Browser publication is not used in backend_api mode; these values remain safe.
AUTO_OPEN_ADMIN=false
AUTO_PUBLISH_TIMEOUT_SECONDS=90
BROWSER_COMMAND=
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO_MS=0
PLAYWRIGHT_AUTH_STATE=data/admin_auth.json
